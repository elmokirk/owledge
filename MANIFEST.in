# V1 Minimal Core sdist: ship only package inputs and direct user documentation.
# Optional add-ons, benchmark corpora, plugins, examples, and standalone skill
# bundles remain source-checkout/post-V1 material rather than hidden GA payload.
include AGENTS.template.md
include CHANGELOG.md
include CLAUDE.template.md
include CONTRIBUTING.md
include DESIGN.md
include LICENSE
include PRIVACY.md
include OWLEDGE.template.md
include README.md
include REPORT_DESIGN_SELECTOR.html
include SECURITY.md
include USER_CONTEXT.template.md
include VERSION
include .gitignore
include owledge_build.py
exclude OWLEDGE.legacy.template.md
prune docs
recursive-include templates *
include docs/upgrade-notes-schema.json
include docs/upgrading.md
include docs/v1-minimal-core.md
recursive-include skills *
include tools/__init__.py
include tools/owledge.py
include tools/owledge_core.py
include tools/owledge_adapter_contracts.py
include tools/owledge_generic_adapter.py
include tools/owledge_null_space.py
include tools/owledge_v1_retrieval.py
include tools/owledge_v1_lifecycle.py
include tools/build_project_folder_kit.py
prune addons
prune assets
prune benchmarks
prune examples
prune plugins
prune standalone-skills
prune tests
prune owlib
recursive-exclude .agent-control *
recursive-exclude .git *
recursive-exclude internal *
recursive-exclude global-memory *
global-exclude __pycache__
global-exclude *.py[cod]
