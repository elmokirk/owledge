{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://owledge.dev/schemas/research-memory-v1.schema.json","title":"Owledge Research Memory v1","type":"object","additionalProperties":false,"required":["stable_id","record_type","knowledge_scope","research_reason","source_revision","source_mutability","source_hash","lifecycle","relations","retrieved_at","verified_at"],"properties":{"stable_id":{"type":"string","minLength":1},"record_type":{"enum":["research_brief","source_record","atomic_finding","synthesis","research_task_index"]},"knowledge_scope":{"enum":["project_user","user_global","enterprise"]},"research_reason":{"type":"string","minLength":1},"context":{"type":"string","minLength":1},"summary":{"type":"string","minLength":1},"source_ref":{"type":"string","minLength":1},"publication_at":{"type":"string"},"search_at":{"type":"string"},"source_revision":{"type":"string","minLength":1},"source_mutability":{"enum":["immutable","versioned","mutable"]},"source_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"lifecycle":{"type":"string","minLength":1},"relations":{"type":"array"},"retrieved_at":{"type":"string","minLength":1},"verified_at":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"record_type":{"const":"research_brief"}}},"then":{"required":["context"]}},{"if":{"properties":{"record_type":{"const":"source_record"}}},"then":{"required":["source_ref"]}},{"if":{"properties":{"record_type":{"enum":["atomic_finding","synthesis"]}}},"then":{"required":["summary"]}},{"if":{"properties":{"record_type":{"const":"research_task_index"}}},"then":{"required":["context"]}}]}
