{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owledge.dev/schemas/artifact-envelope-v1.schema.json",
  "title": "Owledge ArtifactEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["memory_id", "schema_version", "profile_version", "document_version", "source_hash", "knowledge_scope", "server_project_scope", "owner_user_id", "lifecycle", "visibility", "data_class", "audience_ids", "transferability", "applies_to", "edges", "extensions"],
  "properties": {
    "memory_id": {"type": "string", "pattern": "^mem:"},
    "schema_version": {"type": "string", "const": "1.0"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "document_version": {"type": "integer", "minimum": 1},
    "source_hash": {"type": "string", "minLength": 16},
    "knowledge_scope": {"enum": ["project_user", "user_global", "enterprise"]},
    "server_project_scope": {"type": "string", "minLength": 1},
    "owner_user_id": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["candidate", "raw_inbox", "reviewed", "canonical", "superseded", "archived"]},
    "visibility": {"enum": ["private", "tenant", "customer", "shared"]},
    "data_class": {"enum": ["public", "internal", "confidential", "personal", "special-category"]},
    "audience_ids": {"type": "array", "items": {"type": "string"}},
    "transferability": {"enum": ["none", "project_only", "user_global_candidate", "enterprise_candidate", "reviewed_global"]},
    "applies_to": {"type": "array", "items": {"type": "string"}},
    "edges": {"type": "array", "items": {"$ref": "edge.schema.json"}},
    "extensions": {"type": "object", "patternProperties": {"^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$": {}}, "additionalProperties": false},
    "resource_refs": {"type": "array", "items": {"$ref": "resource-ref-v1.schema.json"}},
    "profile": {"type": "string"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
