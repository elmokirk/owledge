{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owledge.dev/schemas/adapter-manifest-v1.schema.json",
  "title": "Owledge AdapterManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "adapter_id",
    "core_api_range",
    "granted_permissions",
    "context_scopes",
    "supported_capabilities",
    "unsupported_capabilities"
  ],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "adapter_id": {"enum": ["codex", "claude-code", "generic-mcp-cli"]},
    "core_api_range": {"pattern": "^>=[0-9]+\\.[0-9]+\\.[0-9]+,<[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "granted_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["read_project", "read_user_global", "write_candidate"]}
    },
    "context_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["project_user", "user_global"]}
    },
    "supported_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["context.read", "control.read", "checkpoint.handoff", "candidate.write"]}
    },
    "unsupported_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "reason_code"],
        "properties": {
          "capability_id": {"enum": ["preplan.auto_inspect", "routing.durable", "core.storage.direct", "scope.enterprise", "orchestration.dispatch"]},
          "reason_code": {"type": "string", "minLength": 1}
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["fixtures/session-start.json", "fixtures/user-prompt.json"]}
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
